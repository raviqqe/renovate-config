{
  "onboarding": false,
  "requireConfig": "optional",
  "enabledManagers": ["npm"],
  "automerge": true,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "matchDepTypes": ["engines"],
      "enabled": true,
      "rangeStrategy": "bump"
    },
    {
      "matchDepTypes": ["packageManager"],
      "matchPackageNames": ["pnpm"],
      "enabled": true,
      "minimumReleaseAge": "1 day"
    }
  ]
}
