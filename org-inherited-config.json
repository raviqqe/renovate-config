{
  "onboarding": false,
  "requireConfig": "optional",
  "enabledManagers": ["gomod", "npm"],
  "automerge": true,
  "minimumReleaseAge": "1 day",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchManagers": ["!gomod"],
      "enabled": false
    },
    {
      "description": "Indirect Go modules stay disabled by default unless they provide tools.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["!indirect"],
      "enabled": false
    },
    {
      "description": "Renovate does not tidy Go modules or rewrite tool paths on major updates.",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchDepTypes": ["engines"],
      "enabled": true,
      "rangeStrategy": "bump"
    },
    {
      "matchDepTypes": ["packageManager"],
      "matchPackageNames": ["pnpm"],
      "enabled": true
    }
  ]
}
